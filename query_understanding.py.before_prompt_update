# ============================================================
# JSON CLEANING
# ============================================================

def clean_json_text(text):
    """
    Remove common markdown wrappers around JSON.
    """

    if text is None:
        return ""

    text = text.strip()

    # Remove markdown code fence.
    if text.startswith("```"):

        text = re.sub(
            r"^```(?:json)?",
            "",
            text,
            flags=re.IGNORECASE
        )

        text = re.sub(
            r"```$",
            "",
            text
        )

    return text.strip()


# ============================================================
# JSON EXTRACTION
# ============================================================

def extract_json(text):
    """
    Robustly extract the first JSON object from model output.
    """

    text = clean_json_text(text)

    # --------------------------------------------------------
    # Direct JSON parsing
    # --------------------------------------------------------

    try:

        return json.loads(text)

    except Exception:

        pass


    # --------------------------------------------------------
    # Extract JSON object from surrounding text
    # --------------------------------------------------------

    start = text.find("{")

    end = text.rfind("}")


    if (
        start != -1
        and end != -1
        and end > start
    ):

        candidate = text[
            start:end + 1
        ]


        try:

            return json.loads(
                candidate
            )

        except Exception:

            pass


    return None


# ============================================================
# NORMALIZE LIST FIELD
# ============================================================

def normalize_list_field(
    value
):
    """
    Ensure every structured field is a list of concise strings.
    """

    if value is None:

        return []


    if isinstance(
        value,
        str
    ):

        value = value.strip()

        if not value:

            return []

        return [value]


    if isinstance(
        value,
        list
    ):

        result = []

        for item in value:

            item = str(
                item
            ).strip()

            if item:

                result.append(
                    item
                )

        return result


    return [
        str(value).strip()
    ]


# ============================================================
# NORMALIZE PARSED OUTPUT
# ============================================================

def normalize_output(
    parsed
):

    if not isinstance(
        parsed,
        dict
    ):

        return None


    fields = [

        "host_or_crop",

        "plant_part",

        "visible_damage",

        "visible_symptoms",

        "visual_features",

        "insect_or_pest_observation",

        "environmental_context",

        "damage_location",

        "damage_pattern",

        "visible_color_changes",

        "retrieval_terms",
    ]


    normalized = {}


    for field in fields:

        normalized[field] = (
            normalize_list_field(
                parsed.get(
                    field,
                    []
                )
            )
        )


    return normalized


# ============================================================
